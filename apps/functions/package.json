{
  "name": "@sistema-redespachos/functions",
  "version": "0.0.1",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "deploy:prepare": "node scripts/prepareDeploy.mjs",
    "dev": "tsc -p tsconfig.build.json && node scripts/prepareDeploy.mjs && tsc -p tsconfig.build.json --watch --preserveWatchOutput --outDir dist/lib"
  },
  "dependencies": {
    "@sistema-redespachos/shared": "workspace:*",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.5.0"
  }
}
