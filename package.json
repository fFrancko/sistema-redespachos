{
  "name": "sistema-redespachos",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "description": "Sistema de cotización y gestión de redespachos para QX",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:ui": "vitest --ui",
    "build": "pnpm -r build",
    "dev": "pnpm -C apps/web dev",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
