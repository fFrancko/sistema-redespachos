{
  "name": "sistema-redespachos",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "description": "Sistema de cotización y gestión de redespachos para QX",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r build",
    "dev": "pnpm -C apps/web dev",
    "dev:emulator": "firebase emulators:start",
    "lint": "eslint apps/web/src apps/functions packages --max-warnings 0",
    "format": "prettier --write .",
    "ci:run": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.0.0",
    "firebase-tools": "^13.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
